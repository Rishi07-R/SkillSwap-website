# ==============================================================================
# SkillSwap Environment Variables
# ==============================================================================
# In Supabase Dashboard -> Project Settings -> API:
# 1. Project URL -> VITE_SUPABASE_URL
# 2. Project API anon key -> VITE_SUPABASE_ANON_KEY
#
# NOTE: SkillSwap includes a seamless Local Demo Mode! If these values remain empty
# or placeholder, the application will gracefully run using high-fidelity local state
# and the rich seed dataset, allowing instant testing and demonstration.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
